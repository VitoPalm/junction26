# PRIVATE LOCAL DEVELOPMENT ONLY. Copy to .env.assistant.local (git-ignored).
# This is the Junction26 API user session, never a Claude/OpenAI API key.
JUNCTION26_API_ORIGIN=http://127.0.0.1:8080
JUNCTION26_AUTHORING_TOKEN=dev:me
# Optional, only for the http-local transport (always binds 127.0.0.1).
JUNCTION26_MCP_PORT=8090
