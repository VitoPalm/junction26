{
  "name": "@junction26/author",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoring app (web + iOS + Android via Capacitor): library, chat, uploads, preview, publish, glasses pairing.",
  "scripts": {
    "test": "node --test src/api.test.ts",
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit && vite build",
    "build:native": "tsc --noEmit && vite build --mode native",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build:native && cap sync",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:ios": "npm run cap:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@clerk/react": "6.18.8",
    "@junction26/applet-format": "*",
    "@junction26/applet-renderer": "*",
    "@junction26/applet-runtime": "*",
    "@junction26/glasses-ui": "*",
    "@wearables-ui-toolkit/androidx-shapes": "130.33.0",
    "@wearables-ui-toolkit/icons": "130.33.0",
    "@wearables-ui-toolkit/mrbd": "130.33.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
