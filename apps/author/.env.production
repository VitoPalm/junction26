# Public build configuration for the deployed web authoring app (read by `vite build`).
# Publishable keys are public by design; never put a secret key in a VITE_ variable.
# Hackathon decision: the deployed app uses the Clerk development instance.
# Switch to a pk_live_… key and drop VITE_CLERK_ALLOW_DEVELOPMENT for a real release.
VITE_AUTH_MODE=clerk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_YXB0LWtyaWxsLTk1MjguY2xlcmsuYWNjb3VudHMuZGV2JA
VITE_CLERK_ALLOW_DEVELOPMENT=true
