# Local development settings for apps/api and apps/worker (copy to .env.backend.local).
# Verda and OpenRouter secrets are read from .env.verda.local / .env.openrouter.local.
NODE_ENV=development
LOG_LEVEL=info
PORT=8080
DATABASE_URL=postgres://j26:dev@127.0.0.1:55432/j26
# Integration tests create and drop throwaway databases on this server.
TEST_DATABASE_URL=postgres://j26:dev@127.0.0.1:55432/postgres
MIGRATE_ON_START=true
# fs: objects on local disk (shared by api + worker), s3: Verda (needs .env.verda.local).
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=../../.data/objects
AUTH_MODE=dev
# For real web accounts, set AUTH_MODE=clerk and configure your Clerk instance:
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:5173,http://localhost:5173
# Preferred: backend secret key (supports fetching current signing keys).
# CLERK_SECRET_KEY=          # set only in .env.backend.local / runtime secrets
# Alternative: PEM public key; literal \n separators are supported. Rotate manually.
# CLERK_JWT_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
PUBLIC_ORIGIN=http://127.0.0.1:8080

# Free canned generation for development (pick "Demo" in the app).
AUTHORING_MODELS=fake:demo
# Free keyword matcher for the voice bridge (real default needs OPENROUTER_API_KEY).
VOICE_MODEL=fake:voice

# Optional hosted MCP account linking (requires AUTH_MODE=clerk).
# Canonical endpoint: use HTTPS for cloud Claude/ChatGPT connectors.
# MCP_RESOURCE_URL=http://127.0.0.1:8080/mcp
# CLERK_PUBLISHABLE_KEY=pk_test_...   # same instance as the authoring UI
# Requires CLERK_SECRET_KEY even when CLERK_JWT_KEY is configured.

# Optional native providers. Put actual keys only in .env.backend.local/runtime secrets.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# AUTHORING_MODELS=anthropic:your-claude-model,gemini:your-gemini-model,fake:demo
# Optional independent OpenAI-compatible providers (same settings on API + worker).
# MODEL_PROVIDERS='[{"id":"local","baseUrl":"http://127.0.0.1:11434/v1","auth":"none","responseFormat":"prompt","capabilities":{"tools":true}}]'
# Then add local:your-model to AUTHORING_MODELS. Tool support is opt-in for custom endpoints.
# For hosted endpoints use apiKeyEnv:"YOUR_PROVIDER_API_KEY" and set that secret separately.
# OPENAI_RESPONSE_FORMAT=json_schema
# OPENAI_TOKEN_PARAMETER=max_completion_tokens
