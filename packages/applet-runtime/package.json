{
  "name": "@junction26/applet-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure applet state machine (dispatch, initial state, migration). Used by the glasses app and the authoring preview.",
  "exports": {
    ".": {
      "junction26-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --conditions=junction26-source --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@junction26/applet-format": "*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
